APP_NAME=Academic Submission Agent
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://asa_app:replace-with-local-password@127.0.0.1:3306/academic_submission_agent
ALEMBIC_DATABASE_URL=mysql+pymysql://asa_migrate:replace-with-local-password@127.0.0.1:3306/academic_submission_agent
TEST_DATABASE_URL=mysql+pymysql://asa_test:replace-with-local-password@127.0.0.1:3306/academic_submission_agent_test
# Optional only for docker-compose.yml; Homebrew MySQL does not use this.
MYSQL_ROOT_PASSWORD=replace-with-local-password
# Generate a random local secret of at least 32 bytes; never commit it.
CSRF_SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:5173"]
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MAX_UPLOAD_BYTES=104857600
STORAGE_ROOT=/absolute/path/to/local/storage
# Optional isolated storage for scripts/test_api.sh; never inside STORAGE_ROOT.
TEST_STORAGE_ROOT=/absolute/path/to/local/test-storage
# Local HTTP only; use true behind HTTPS outside local development.
SESSION_COOKIE_SECURE=false
# Backup recipient is public; the private key must remain outside this project.
AGE_RECIPIENT=replace-with-local-age-recipient
AGE_SECRET_KEY_FILE=/absolute/path/outside/project/backup-key.txt
# Optional isolated restore target; it must be empty and end in _test.
RESTORE_DATABASE_URL=mysql+pymysql://asa_test:replace-with-local-password@127.0.0.1:3306/academic_submission_agent_restore_test
