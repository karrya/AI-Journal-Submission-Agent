APP_NAME=Academic Submission Agent
ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://asa_app:replace-with-local-password@127.0.0.1:3306/academic_submission_agent
ALEMBIC_DATABASE_URL=mysql+pymysql://asa_migrate:replace-with-local-password@127.0.0.1:3306/academic_submission_agent
TEST_DATABASE_URL=mysql+pymysql://asa_test:replace-with-local-password@127.0.0.1:3306/academic_submission_agent_test
# Optional only for docker-compose.yml; Homebrew MySQL does not use this.
MYSQL_ROOT_PASSWORD=replace-with-local-password
# Generate a random local secret of at least 32 bytes; never commit it.
CSRF_SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:5173"]
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
MAX_UPLOAD_BYTES=104857600
STORAGE_ROOT=/absolute/path/to/local/storage
